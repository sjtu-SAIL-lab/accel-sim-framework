# Jetson Orin baseline: original two-level SRAM hierarchy.
# Latency is expressed in 1.3 GHz core cycles; energy is pJ/access.
-accel_scope_enabled 1
-power_simulation_enabled 1
-gpgpu_runtime_stat 50000
-accel_scope_gpu_nonstorage_scale 0.015
-gpgpu_cache:dl3 none
-accel_scope_l2_latency 3
-accel_scope_l3_latency 0
-accel_scope_l1_access_energy_pj 82.901100
-accel_scope_l2_access_energy_pj 323.851650
-accel_scope_l3_access_energy_pj 0.0
-accel_scope_dram_access_energy_pj 2560.0
-accel_scope_l1_static_power_mw 0.4605892
-accel_scope_l2_static_power_mw 2.30405544
-accel_scope_l3_static_power_mw 0.0
-accel_scope_noncache_power_mw 0.0
