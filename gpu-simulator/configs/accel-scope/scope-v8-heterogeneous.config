# SCOPE v8 optimum: L1 SRAM + L2 TFET-eDRAM + L3 OSFET-eDRAM.
# L2 is 32 MiB total and L3 is 384 MiB total across 16 partitions.
-accel_scope_enabled 1
-power_simulation_enabled 1
-gpgpu_runtime_stat 50000
-accel_scope_gpu_nonstorage_scale 0.015
-gpgpu_cache:dl2 S:1024:128:16,L:B:m:L:L,A:192:32,32:0,32
-gpgpu_cache:dl3 S:12288:128:16,L:B:m:L:L,A:1024:64,64:0,64
-accel_scope_l3_partition_queues 64:64:64:64
-accel_scope_l2_latency 3
-accel_scope_l3_latency 35
-accel_scope_l1_access_energy_pj 82.901100
-accel_scope_l2_access_energy_pj 345.560893
-accel_scope_l3_access_energy_pj 1428.444289
-accel_scope_dram_access_energy_pj 2560.0
-accel_scope_l1_static_power_mw 0.4605892
-accel_scope_l2_static_power_mw 1.8198388
# Includes 8.66346552 mW static plus 3.681536286 mW refresh.
-accel_scope_l3_static_power_mw 12.345001806
-accel_scope_noncache_power_mw 0.0
